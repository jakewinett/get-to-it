// Copy to Secrets.xcconfig (gitignored), then replace the values on the lines below.
// Edit these lines in place. Don't add new ones: if a setting appears twice, the last line wins.
// "//" starts a comment in xcconfig files, so the URL's slashes are split with $().

// Supabase project URL.
SUPABASE_URL = https:/$()/dseikrlmwwbguyvdamif.supabase.co

// Supabase dashboard → Project Settings → API Keys → publishable key (starts with sb_publishable_).
SUPABASE_PUBLISHABLE_KEY = REPLACE_WITH_PUBLISHABLE_KEY

// Apple Developer Team ID: developer.apple.com → Account → Membership details (10 characters).
DEVELOPMENT_TEAM = REPLACE_WITH_TEAM_ID
